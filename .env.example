# Скопируйте в .env и заполните. Файл .env в git не попадает.

# ── Сервер ──────────────────────────────────────────────
PORT=8080
# Домен без https:// — на него Caddy выпустит сертификат (docker compose)
DOMAIN=bot.seafood-sochi.ru
# Публичный адрес с HTTPS (нужен для мини-приложения, фото в боте и вебхуков)
PUBLIC_URL=https://bot.seafood-sochi.ru

# ── Админ-панель: https://ваш-домен/admin ───────────────
# Длинный пароль, не короче 12 символов. Без него панель выключена.
ADMIN_PASSWORD=

# ── Telegram (токен от @BotFather) ─────────────────────
TG_TOKEN=
# polling — для старта, webhook — для постоянной работы
TG_MODE=polling
TG_WEBHOOK_SECRET=придумайте-длинную-строку-латиницей
# Необязательно: chat_id менеджеров через запятую (проще подключаться командой /manager)
TG_MANAGER_CHAT_IDS=

# ── MAX (токен с платформы MAX для партнёров) ──────────
MAX_TOKEN=
# Публичное имя бота, к которому привязано мини-приложение (если пусто — возьмём из /me)
MAX_BOT_NAME=
MAX_MODE=polling
MAX_WEBHOOK_SECRET=придумайте-длинную-строку-латиницей
MAX_MANAGER_CHAT_IDS=

# ── Менеджеры ──────────────────────────────────────────
# Сотрудник пишет боту «/manager 4821» и начинает получать заказы и вопросы
MANAGER_PIN=

# ── Битрикс24 (необязательно) ──────────────────────────
# Входящий вебхук с правами CRM, вида https://xxx.bitrix24.ru/rest/1/abcdef123/
B24_WEBHOOK=
# lead — лид, deal — сделка с контактом
B24_ENTITY=lead
B24_SOURCE_ID=
B24_ASSIGNED_ID=

# ── Прочее ─────────────────────────────────────────────
# Слоты доставки через запятую
TIME_SLOTS=Сегодня до 15:00,Сегодня 15:00–21:00,Завтра 9:00–13:00,Завтра 13:00–17:00,Завтра 17:00–21:00
# Разрешить заказ из обычного браузера (без Telegram/MAX). Такие заказы помечаются ⚠️
ALLOW_WEB_ORDERS=1
